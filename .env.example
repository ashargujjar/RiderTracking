# Docker Compose settings — host ports and database name.
# Copy this file to .env in the project root; `docker compose up` loads it automatically.
#
# App secrets (JWT_SECRET, ADMIN_USERNAME, ADMIN_PASSWORD, ADMIN_EMAIL, CORS_ORIGIN)
# are separate — see backend/.env.example and copy that to backend/.env too.

MONGO_PORT=27017
MONGO_DB_NAME=catkin
BACKEND_PORT=5000
FRONTEND_PORT=5173

# Production only (docker-compose.prod.yml) — baked into the admin dashboard
# bundle at build time, so it must be the real public backend URL, e.g.
# https://catkin-api.duckdns.org. Not used by the local dev compose file.
VITE_API_URL=
