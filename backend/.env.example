MONGODB_URI=mongodb://mongo:27017/catkin
JWT_SECRET=sdsbnksnksn##@$
CORS_ORIGIN=http://localhost:5173
# Seeded on server startup if no admin user with this username exists yet.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
# Used by middleware/cloudinary.ts to host complaint/resolution photos.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SAFEPAY_PUBLIC_KEY=
SAFEPAY_SECRET_KEY=
# Set once you register the webhook URL in the Safepay dashboard — it's a
# separate secret from SAFEPAY_SECRET_KEY, used only to verify that incoming
# webhook calls really came from Safepay.
SAFEPAY_WEBHOOK_SECRET=
# sandbox while testing; switch to "production" once you go live.
SAFEPAY_ENVIRONMENT=sandbox
# Public URL of THIS backend — used only to build the page a client's browser
# lands on after paying (payment.model.ts's redirectUrl/cancelUrl). Left
# unset, it defaults to localhost, which is unreachable from a real phone.
# Set to your real deployed URL, e.g. https://catkin-api.duckdns.org
BACKEND_PUBLIC_URL=