# Replace both subdomains below with the two you registered on DuckDNS
# (duckdns.org), each pointed at your Elastic IP. Caddy automatically
# provisions and renews free, trusted HTTPS certificates (Let's Encrypt) for
# each — this works for a DuckDNS subdomain exactly like a real domain.

catkin-api.duckdns.org {
	reverse_proxy backend:5000
}

catkin-app.duckdns.org {
	reverse_proxy frontend:80
}
